{"run_id": "5b6dbc6142a5", "ts": "2026-09-07T05:38:26+00:00", "question_id": "A1", "question": "Who are our most active customers?", "arm": "b1", "prompt_version": "b1-v1", "provider": "asu", "model": "muse-glimmer-30b", "temperature": 0.0, "sql": "SELECT c.customer_id, c.customer_name, c.region, COUNT(o.order_id) AS number_of_orders, SUM(o.total_amount) AS total_spent\nFROM customers c\nJOIN orders o ON c.customer_id = o.customer_id\nGROUP BY c.customer_id, c.customer_name, c.region\nORDER BY number_of_orders DESC, total_spent DESC", "refused": false, "missing_field": null, "assumptions": null, "exec_ok": true, "rows": 20, "truncated": false, "error_type": null, "error": null, "prompt_tokens": 278, "completion_tokens": 840, "latency_ms": 17240.1}
{"run_id": "5b6dbc6142a5", "ts": "2026-09-07T05:38:43+00:00", "question_id": "A2", "question": "How did we perform last quarter?", "arm": "b1", "prompt_version": "b1-v1", "provider": "asu", "model": "muse-glimmer-30b", "temperature": 0.0, "sql": "WITH cur AS (\n  SELECT strftime('%Y','now') AS yr,\n         ((CAST(strftime('%m','now') AS INTEGER)-1)/3)+1 AS qtr\n)\nSELECT SUM(o.total_amount) AS total_sales,\n       COUNT(o.order_id) AS total_orders,\n       AVG(o.total_amount) AS avg_order_value\nFROM orders o\nCROSS JOIN cur\nWHERE strftime('%Y', o.order_date) = \n      CASE WHEN cur.qtr = 1 THEN CAST(cur.yr AS INTEGER)-1 ELSE cur.yr END\n  AND ((CAST(strftime('%m', o.order_date) AS INTEGER)-1)/3)+1 = \n      CASE WHEN cur.qtr = 1 THEN 4 ELSE cur.qtr - 1 END", "refused": false, "missing_field": null, "assumptions": null, "exec_ok": true, "rows": 1, "truncated": false, "error_type": null, "error": null, "prompt_tokens": 278, "completion_tokens": 2540, "latency_ms": 50048.2}
